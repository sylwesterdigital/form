# Add this location to the HTTPS server block that should expose the app.
# Protect it because uploaded CVs and browser state contain personal data.

location /labs/form/ {
    proxy_pass http://127.0.0.1:5099/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 180s;
    client_max_body_size 12m;

    # Recommended if the site is reachable from the public Internet:
    # auth_basic "Form";
    # auth_basic_user_file /etc/nginx/.htpasswd-form;
}
